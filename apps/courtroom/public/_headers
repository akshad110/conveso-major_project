/*
  Content-Security-Policy: frame-ancestors 'self' http://localhost:3000 http://127.0.0.1:3000 https://*.vercel.app https://*.onrender.com
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/models/*
  Cache-Control: public, max-age=31536000, immutable

/video/*
  Cache-Control: public, max-age=31536000, immutable
