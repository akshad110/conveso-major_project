# Copy to .env.local and edit if your setup differs.
# The 3D classroom loads with none of the values below set. Ollama is optional
# and is only used when a student asks the teacher a question.

# LMS origin this room reports a finished lesson back to. Required in production
# because the classroom is iframed from another host. Leave unset locally and
# the room uses the page that framed it.
NEXT_PUBLIC_CONVERSO_URL=

# Where Ollama listens.
OLLAMA_URL=http://127.0.0.1:11434

# The model to ask. If it isn't installed the app falls back to whatever is,
# preferring llama / qwen / mistral / gemma in that order.
# qwen2.5:7b writes noticeably better Japanese, Hindi and Korean than llama3.1:8b.
OLLAMA_MODEL=llama3.1:8b

# How long to wait for one answer. The first request of a session also loads the
# weights, which on an 8B is 10-20s on top of the answer itself.
OLLAMA_TIMEOUT_MS=120000

# Context window. Must fit prompt (~1k) + answer (~500). Do not lower this:
# when the window overflows, llama.cpp drops the OLDEST tokens — the system
# message holding the schema — and the model then answers in the wrong shape.
OLLAMA_NUM_CTX=4096

# How long Ollama keeps the weights in memory after a question. Longer means the
# second question is fast; shorter frees several GB of RAM sooner.
OLLAMA_KEEP_ALIVE=30m

# Where answers are mirrored so they survive a `next dev` reload. Set to an empty
# value to keep the cache in memory only; delete the file to forget every answer.
AI_TEACHER_CACHE_FILE=.cache/ai-teacher-answers.json
