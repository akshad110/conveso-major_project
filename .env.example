# Converso suite — environment template
#
# Copy the sections you need into the app that reads them. They are deliberately
# NOT one shared file at runtime:
#
#   apps/lms/.env.local         everything under CONVERSO
#   apps/courtroom/.env.local   everything under COURTROOM
#   apps/classroom/.env.local   see apps/classroom/.env.example (Ollama only)
#
# The split is the security boundary. The LMS holds the database key and the
# signing secret; the two scene apps hold two URLs between them and nothing else.
# If a Supabase key ever appears in a VITE_ or NEXT_PUBLIC_ variable, it is in the
# browser, and `npm run verify` is written to fail on exactly that.


# ─────────────────────────────────────────────────────────────────────────────
# CONVERSO (apps/lms) — identity
# ─────────────────────────────────────────────────────────────────────────────
# Unchanged from the Converso you already run. There is one login in this suite
# and it is this one; the courtroom and the classroom never see a Clerk key.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in


# ─────────────────────────────────────────────────────────────────────────────
# CONVERSO (apps/lms) — data
# ─────────────────────────────────────────────────────────────────────────────
# Also unchanged. The service-role key is server-only and must never be given a
# NEXT_PUBLIC_ prefix: that prefix is what puts a value in the JavaScript bundle,
# and this particular value bypasses every row-level policy in the database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# CONVERSO (apps/lms) — voice and models
# ─────────────────────────────────────────────────────────────────────────────
# Unchanged. Vapi's web token is public by design — it is scoped to the
# assistant, not the account. Gemini's is not, and has no NEXT_PUBLIC_ twin.
NEXT_PUBLIC_VAPI_WEB_TOKEN=
GEMINI_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# CONVERSO (apps/lms) — launching the heavy scenes
# ─────────────────────────────────────────────────────────────────────────────
# NEW. The secret that signs launch tokens. Server-only, read in exactly one
# file (lib/launch.ts), and 16 characters minimum — the signer throws below that
# rather than pretend a four-character secret is a secret.
#
#   openssl rand -base64 32
#
# Rotating it invalidates every unspent token, which is at most two minutes of
# clicks, so rotate freely.
LAUNCH_TOKEN_SECRET=

# Where each scene is served. Both are NEXT_PUBLIC_ because the browser needs to
# navigate to them; both are URLs and neither is a credential. If a scene's URL
# is unset, Converso refuses to start that kind of simulation with a 503 naming
# the variable instead of opening a blank iframe.
NEXT_PUBLIC_COURTROOM_URL=http://localhost:5173
NEXT_PUBLIC_LANGUAGE_SCENE_URL=http://localhost:3001

# Which origins may exchange a launch token. There is no variable for this on
# purpose — the allow-list is derived from the two URLs above, so a port that
# moves cannot leave CORS pointing at the old one. It is an allow-list compared
# with `includes` and never "*", because a wildcard plus a bearer token is how a
# student's session gets read by any page that can guess a session id.


# ─────────────────────────────────────────────────────────────────────────────
# COURTROOM (apps/courtroom) — build-time, Vite
# ─────────────────────────────────────────────────────────────────────────────
# Which Converso to report back to. Read at build time on purpose. The obvious
# alternative — take the origin from the launch URL — means a page that frames
# the courtroom can name its own server and be handed the student's token.
VITE_CONVERSO_URL=http://localhost:3000

# The engine's WebSocket. Set to the literal string "off" to run the room with no
# engine at all, which is how the 3D work gets done without a trial in progress.
VITE_COURT_WS_URL=ws://127.0.0.1:4177
